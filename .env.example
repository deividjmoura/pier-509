# Copie este arquivo para .env e ajuste os valores.

# String de conexão do PostgreSQL (Neon, Render, local…)
# Neon costuma vir com ?sslmode=require — o app normaliza para verify-full
# automaticamente e elimina o SECURITY WARNING do driver pg.
DATABASE_URL=postgres://usuario:senha@localhost:5432/lanchonete_qr

# true em serviços gerenciados que exigem SSL (Render, Neon, Heroku, etc.)
# Pode ficar false se a própria DATABASE_URL já trouxer sslmode=.
DATABASE_SSL=false

# Só use false se o provedor tiver certificado que o Node não confia
# (raro no Neon free). Em produção o padrão é validar o certificado.
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Tamanho do pool e timeout de conexão (opcional)
# PG_POOL_MAX=10
# PG_CONNECT_TIMEOUT_MS=10000

PORT=3000

# Senha usada no seed inicial dos usuários admin/cozinha/caixa
STAFF_SEED_PASSWORD=admin123

# PIX estático (QR / copia-e-cola na mesa e no caixa)
# Chave: CPF (11 dígitos), CNPJ, e-mail, telefone (+5511...) ou chave aleatória
# Exemplos:
#   PIX_CHAVE=12345678901
#   PIX_CHAVE=123.456.789-01   (também funciona — normalizamos)
#   PIX_CHAVE=seu@email.com
#   PIX_CHAVE=+5511999999999
PIX_CHAVE=
PIX_NOME=LANCHONETE
PIX_CIDADE=SAO PAULO

# NODE_ENV=production

# Fuso do estabelecimento (dashboard / relatórios)
APP_TIMEZONE=America/Sao_Paulo
